APP_NAME="St Mary's Cathedral"
APP_ENV=production
APP_KEY=base64:generate-with-php-artisan-key-generate-show
APP_DEBUG=false
APP_URL=https://church-2m8b.onrender.com
FRONTEND_URL=https://churchst.netlify.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Paste the Supabase session-pooler connection string into DB_URL in Render.
DB_CONNECTION=pgsql
DB_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres
DB_SSLMODE=require
DB_PERSISTENT=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
SESSION_PARTITIONED_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync

# Render's local filesystem is ephemeral. Attach a persistent disk for uploads.
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=no-reply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"
